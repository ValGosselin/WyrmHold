<!-- L'overlay en jeu, façon Steam : un voile sombre sur tout l'écran, une barre en haut (jeu, session, heure, PC),
     trois onglets au milieu (Accueil, Succès, Aide) et une barre de boutons en bas.
     Contrairement à l'ancien petit overlay, il PREND le clavier et la souris tant qu'il est ouvert (comme Maj+Tab
     dans Steam) : Échap, le bouton « Retour au jeu » ou le raccourci le referment et rendent la main au jeu.
     Style="{x:Null}" : pas le style Fluent des fenêtres (fond, bordure), incompatible avec une fenêtre transparente ;
     les contrôles à l'intérieur (boutons, listes…) gardent le thème de Wyrmhold (clair ou sombre). -->
<Window x:Class="WyrmHold.App.OverlayHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WyrmHold.App"
        Style="{x:Null}"
        Title="Wyrmhold — overlay"
        WindowStyle="None" AllowsTransparency="True" Background="#B3000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Une « carte » : un bloc opaque aux couleurs du thème, posé sur le voile. -->
        <Style x:Key="HubCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- Petit libellé en capitales au-dessus d'une valeur (barre du haut) -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Un succès en version courte (accueil) : icône, nom, description, barre d'avancement, « ❓ ». -->
        <DataTemplate x:Key="HubAchievementTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#2A2A2A" CornerRadius="4" VerticalAlignment="Top" Margin="0,0,10,0">
                    <Image local:WebImageLoader.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource DescriptionTextBrush}" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ProgressVisibility}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <ProgressBar Height="5" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}"
                                     Foreground="#4A90D9" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding RarityText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding UnlockedText}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                    <Button Content="❓" FontSize="11" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Right"
                            ToolTip="Comment l'obtenir ?" Visibility="{Binding HowToGetVisibility}" Click="HowToGet_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Barre du haut : le jeu, la session, l'heure, le PC ===== -->
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/Assets/logo-256.png" Width="36" Height="36" Margin="0,0,18,0" VerticalAlignment="Center"/>

                <Border DockPanel.Dock="Left" Width="44" Height="64" CornerRadius="4" Background="#2A2A2A" Margin="0,0,14,0" ClipToBounds="True">
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Border>

                <!-- À droite : les chiffres -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="SESSION" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="SessionText" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="PROCESSEUR" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="MÉMOIRE" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="HEURE" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="ClockText" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GameNameText" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GameInfoText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Au milieu : l'onglet affiché ===== -->
        <Grid Grid.Row="1" Margin="40,28">

            <!-- Onglet Accueil -->
            <Grid x:Name="HomeTab">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Carte Succès -->
                <Border Style="{StaticResource HubCard}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Voir tous les succès →" Padding="12,4" VerticalAlignment="Top"
                                    Click="AllAchievements_Click"/>
                            <TextBlock Text="🏆 Succès" Style="{StaticResource CardTitle}"/>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <TextBlock x:Name="HomeProgressText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="HomeProgressBar" Height="12" Maximum="1"
                                         Foreground="#FFC107" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                        </DockPanel>

                        <TextBlock x:Name="HomeAchievementsStatus" DockPanel.Dock="Top" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel x:Name="HomeAchievementsSections" Margin="0,0,8,0">
                                <TextBlock Text="★ DÉBLOQUÉS PENDANT CETTE SESSION" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="SessionUnlocksEmpty" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                           Text="Aucun pour l'instant. Ils apparaîtront ici dès qu'ils seront débloqués."/>
                                <ItemsControl x:Name="SessionUnlocksList" ItemTemplate="{StaticResource HubAchievementTemplate}"/>

                                <TextBlock x:Name="NextGoalsTitle" Text="◔ PROCHAINS OBJECTIFS" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl x:Name="NextGoalsList" ItemTemplate="{StaticResource HubAchievementTemplate}"/>

                                <TextBlock x:Name="RarestTitle" Text="◆ LES PLUS RARES QUI RESTENT" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl x:Name="RarestList" ItemTemplate="{StaticResource HubAchievementTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Colonne de droite : session et bloc-notes -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource HubCard}">
                        <StackPanel>
                            <TextBlock Text="⏱ Session" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Commencée à" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,6"/>
                                <TextBlock x:Name="SessionStartText" Grid.Column="1" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Text="Durée" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,6"/>
                                <TextBlock x:Name="SessionDurationText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="2" Text="Succès gagnés" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,6"/>
                                <TextBlock x:Name="SessionAchievementsText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="—"/>

                                <TextBlock Grid.Row="3" Text="Temps de jeu" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,6"/>
                                <TextBlock x:Name="TotalPlaytimeText" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="4" Text="Dernière partie" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                                <TextBlock x:Name="LastPlayedText" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource HubCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="NoteStatusText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="📝 Bloc-notes" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" Text="Propre à ce jeu, gardé sur ton PC (code d'un coffre, quête en cours…)."/>
                            <TextBox x:Name="NoteBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="120"
                                     TextChanged="NoteBox_TextChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Onglet Succès : le même panneau que la fenêtre « Voir les succès » (ajouté par le code) -->
            <Border x:Name="AchievementsTab" Style="{StaticResource HubCard}" Visibility="Collapsed"/>

            <!-- Onglet Aide : le même panneau que la fenêtre Aide (ajouté par le code à la 1re visite) -->
            <Border x:Name="HelpTab" Style="{StaticResource HubCard}" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== Barre du bas : les onglets et le retour au jeu ===== -->
        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕  Retour au jeu" Height="40" Padding="18,0" FontSize="15"
                        Click="BackToGame_Click"/>
                <TextBlock x:Name="HotkeyHintText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Les onglets : coché = onglet affiché (couleur d'accent du thème) -->
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="HomeTabButton" Content="🏠  Accueil" Height="40" Padding="18,0" Margin="0,0,8,0" FontSize="15"
                                  Click="HomeTabButton_Click"/>
                    <ToggleButton x:Name="AchievementsTabButton" Content="🏆  Succès" Height="40" Padding="18,0" Margin="0,0,8,0" FontSize="15"
                                  Click="AchievementsTabButton_Click"/>
                    <ToggleButton x:Name="HelpTabButton" Content="🧭  Aide et guides" Height="40" Padding="18,0" FontSize="15"
                                  Click="HelpTabButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
