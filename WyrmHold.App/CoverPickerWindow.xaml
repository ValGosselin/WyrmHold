<Window x:Class="WyrmHold.App.CoverPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WyrmHold.App"
        Height="680" Width="860" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <!-- Choisir une jaquette (ticket #41) : les jaquettes verticales de SteamGridDB pour ce jeu.
         Un clic sur une image la télécharge et la garde comme jaquette du jeu. -->
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Clique sur une jaquette pour l'utiliser. Elle reste jusqu'à ce que tu en choisisses une autre (ou « Re-télécharger la jaquette », qui reprend celle trouvée automatiquement)."/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Width="90" Height="32" IsCancel="True"/>
            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Images faites par la communauté de SteamGridDB."/>
        </DockPanel>

        <Grid>
            <!-- Chargement, liste vide ou erreur : le message prend la place des images. -->
            <TextBlock x:Name="StatusText" Text="Recherche des jaquettes…" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"/>

            <!-- Padding : la barre de défilement du thème Fluent passe par-dessus le contenu. -->
            <ScrollViewer x:Name="ChoicesScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0" Visibility="Collapsed">
                <ItemsControl x:Name="ChoicesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Le choix est rangé dans Tag : le code le relit au clic. -->
                            <Button Tag="{Binding}" Click="Choice_Click" Margin="0,0,10,10" Padding="4"
                                    Background="Transparent" Cursor="Hand">
                                <Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding Width, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Height, Mode=OneWay}"/>
                                        <Run Text=" · par "/><Run Text="{Binding Author, Mode=OneWay}"/>
                                    </TextBlock>
                                </Button.ToolTip>
                                <Grid Width="150" Height="225" Background="#2A2A2A">
                                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           local:WebImageLoader.DecodeWidth="300"
                                           local:WebImageLoader.Url="{Binding ThumbUrl}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
