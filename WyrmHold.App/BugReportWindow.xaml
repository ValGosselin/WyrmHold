<Window x:Class="WyrmHold.App.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signaler un bug — Wyrmhold"
        Height="640" Width="720" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Décris ce qui s'est passé : ce que tu faisais, ce que tu attendais, ce qui est arrivé à la place."/>

        <!-- AcceptsReturn : Entrée va à la ligne au lieu de valider la fenêtre. -->
        <TextBox x:Name="DescriptionBox" Grid.Row="1" Height="110" Padding="6" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextChanged="DescriptionBox_TextChanged"/>

        <TextBlock Grid.Row="2" Margin="0,14,0,6" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Aperçu : c'est exactement ce qui sera envoyé. Ton nom d'utilisateur, ton SteamID, tes clés et tes jetons ont été retirés."/>

        <TextBox x:Name="PreviewBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Padding="6"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ouvrir sur GitHub" Height="32" Padding="12,0" Margin="0,0,8,0" Click="GitHubButton_Click"
                    ToolTip="Ouvre la page « nouveau ticket » du dépôt, déjà remplie (compte GitHub nécessaire)"/>
            <Button Content="Copier le rapport" Height="32" Padding="12,0" Margin="0,0,8,0" Click="CopyButton_Click"
                    ToolTip="Pour l'envoyer autrement (Discord, e-mail…)"/>
            <!-- IsCancel seul ne ferme qu'une fenêtre ouverte avec ShowDialog ; celle-ci est ouverte avec Show,
                 d'où le Click. IsCancel garde l'intérêt d'Échap, qui « clique » sur ce bouton. -->
            <Button Content="Fermer" Width="90" Height="32" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
