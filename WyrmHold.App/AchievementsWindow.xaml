<Window x:Class="WyrmHold.App.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WyrmHold.App"
        Title="Succès" Height="680" Width="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <DockPanel Margin="14">

        <!-- En haut : le jeu, sa progression et les options d'affichage -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="GameNameText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>

            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Height="12" Maximum="1"
                             Foreground="#FFC107" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Height="32">
                <ComboBox x:Name="ShowFilter" Width="130" SelectedIndex="0" VerticalContentAlignment="Center"
                          SelectionChanged="ShowFilter_SelectionChanged">
                    <ComboBoxItem Content="À faire" Tag="todo"/>
                    <ComboBoxItem Content="Débloqués" Tag="unlocked"/>
                    <ComboBoxItem Content="Tous" Tag="all"/>
                </ComboBox>

                <ComboBox x:Name="SortMode" Width="210" Margin="10,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center"
                          SelectionChanged="SortMode_SelectionChanged">
                    <ComboBoxItem Content="Les plus faciles d'abord" Tag="easiest"/>
                    <ComboBoxItem Content="Les plus rares d'abord" Tag="rarest"/>
                    <ComboBoxItem Content="Ordre du jeu" Tag="game"/>
                    <ComboBoxItem Content="Derniers débloqués" Tag="recent"/>
                </ComboBox>

                <CheckBox x:Name="RevealHidden" Content="Révéler les succès cachés" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="RevealHidden_Changed" Unchecked="RevealHidden_Changed"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="RefreshInfoText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- En bas : fermer (Échap marche aussi grâce à IsCancel) -->
        <Button DockPanel.Dock="Bottom" Content="Fermer" Width="90" Height="32"
                HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>

        <!-- Juste au-dessus : les compteurs bruts que le jeu envoie à Steam (cachés s'il n'y en a pas) -->
        <Expander x:Name="StatsExpander" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"
                           Text="Compteurs envoyés par le jeu à Steam, sans lien officiel avec les succès."/>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,10,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- Au centre : un succès par ligne -->
        <ListBox x:Name="AchievementsList" Margin="0,10,0,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- WebImageLoader télécharge l'icône lui-même et la garde en cache sur le disque -->
                        <Border Grid.Column="0" Width="48" Height="48" Background="#2A2A2A" CornerRadius="4"
                                VerticalAlignment="Top" Margin="0,0,12,0">
                            <Image local:WebImageLoader.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource DescriptionTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <!-- Mini barre d'avancement, seulement pour les succès à compteur pas encore débloqués -->
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ProgressVisibility}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <ProgressBar Height="6" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}"
                                             Foreground="#4A90D9" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="120">
                            <TextBlock Text="{Binding RarityText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding UnlockedText}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="11"
                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
