<Application x:Class="WyrmHold.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WyrmHold.App">
    <Application.Resources>
        <!-- Barre de progression arrondie, fond compris : le thème Fluent n'arrondit que le remplissage.
             WPF règle lui-même la largeur de PART_Indicator d'après PART_Track. -->
        <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="7" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="7" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
