<!-- L'overlay en jeu : petite fenêtre sans bordure, transparente, toujours au premier plan, en haut à droite.
     Style="{x:Null}" : on n'utilise pas le style Fluent des autres fenêtres (fond, bordure), incompatible
     avec une fenêtre transparente. Les couleurs sont fixes : l'overlay est posé sur un jeu, pas sur Wyrmhold.
     ShowActivated="False" : l'afficher ne retire pas le clavier au jeu. -->
<Window x:Class="WyrmHold.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{x:Null}"
        Title="Wyrmhold — overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        SizeChanged="Window_SizeChanged">

    <!-- Fond noir à 70 % d'opacité (B3 en hexadécimal) : on devine le jeu derrière. -->
    <Border Width="240" Padding="12,8" CornerRadius="8"
            Background="#B3181A20" BorderBrush="#26FFFFFF" BorderThickness="1">
        <StackPanel>
            <!-- Deux lignes au plus (MaxHeight) ; au-delà, le nom finit par « … ». -->
            <TextBlock x:Name="GameNameText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
            <TextBlock x:Name="PlatformText" FontSize="11" Foreground="#B3FFFFFF" TextWrapping="Wrap"/>

            <!-- Visible seulement quand un jeu est repéré. -->
            <Grid x:Name="GameDetailsPanel" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Session" FontSize="11" Foreground="#B3FFFFFF" Margin="0,0,10,2"/>
                <TextBlock x:Name="SessionText" Grid.Column="1" FontSize="11" Foreground="White" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Text="Succès" FontSize="11" Foreground="#B3FFFFFF" Margin="0,0,10,0"/>
                <TextBlock x:Name="AchievementsText" Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="White"
                           TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="HotkeyHintText" FontSize="10" Foreground="#80FFFFFF" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
