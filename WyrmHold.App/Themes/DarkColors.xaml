<!-- Palette sombre : les couleurs propres à Wyrmhold (le reste vient du thème Fluent de WPF).
     Chaque clé doit exister dans TOUTES les palettes, avec le même nom. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte secondaire : sous-titres, libellés, compteurs -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6A6A6"/>

    <!-- Texte des descriptions (succès) -->
    <SolidColorBrush x:Key="DescriptionTextBrush" Color="#C8C8C8"/>

    <!-- Fond des cartes de la page Statistiques -->
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>

    <!-- Fond discret : étiquettes de genre, rail des barres de progression -->
    <SolidColorBrush x:Key="SubtleBrush" Color="#3A3A3A"/>

    <!-- Bordure de la fiche du jeu -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F3F3F"/>

    <!-- Texte « Débloqué le … » -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#81C784"/>
</ResourceDictionary>
