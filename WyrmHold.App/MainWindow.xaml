<Window x:Class="WyrmHold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WyrmHold.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        PreviewKeyDown="Window_PreviewKeyDown"
        MinWidth="1150" MinHeight="650"
        mc:Ignorable="d"
        Title="Wyrmhold" Height="750" Width="1200"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <TabControl x:Name="MainTabs" Margin="10" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ===================== Onglet Bibliothèque ===================== -->
        <TabItem Header="Bibliothèque">
            <DockPanel Margin="10">

                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="32">
                    <!-- À droite : les boutons d'action, comme avant -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ThemeButton" Width="46" Margin="0,0,10,0"
                                Click="ThemeButton_Click"/>
                        <Button Content="🎲 Jeu au hasard" Width="130" Margin="0,0,10,0"
                                Click="RandomGameButton_Click"/>
                        <Button x:Name="RefreshButton" Content="Actualiser" Width="100" Margin="0,0,10,0"
                                Click="RefreshButton_Click"/>
                        <Button Content="Jouer" Width="100"
                                Click="PlayButton_Click"/>
                    </StackPanel>

                    <!-- À gauche : les vues enregistrées -->
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SavedViewsList" Width="220" VerticalContentAlignment="Center"
                                  SelectionChanged="SavedViewsList_SelectionChanged"/>
                        <Button Content="Enregistrer la vue…" Width="140" Margin="10,0,0,0"
                                Click="SaveViewButton_Click"/>
                        <Button Content="Supprimer la vue" Width="129" Margin="6,0,0,0"
                                Click="DeleteViewButton_Click"/>
                    </StackPanel>
                </DockPanel>
                <!-- Barre de recherche et filtres -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

                    <!-- Ligne 1 : recherche et filtres -->
                    <StackPanel Orientation="Horizontal" Height="32">
                        <Grid Width="220" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Padding="6,0" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="Rechercher un jeu…" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="InstallFilter" Width="130" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tous les jeux" Tag="all"/>
                            <ComboBoxItem Content="Installés" Tag="installed"/>
                            <ComboBoxItem Content="Non installés" Tag="notInstalled"/>
                        </ComboBox>

                        <ComboBox x:Name="OriginFilter" Width="150" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Toutes origines" Tag="all"/>
                            <ComboBoxItem Content="À moi" Tag="mine"/>
                            <ComboBoxItem Content="Famille Steam" Tag="family"/>
                        </ComboBox>

                        <ComboBox x:Name="ActivityFilter" Width="170" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Toute activité" Tag="all"/>
                            <ComboBoxItem Content="Jamais lancés" Tag="neverPlayed"/>
                            <ComboBoxItem Content="Moins d'1 h de jeu" Tag="underOneHour"/>
                            <ComboBoxItem Content="Plus de 10 h de jeu" Tag="overTenHours"/>
                            <ComboBoxItem Content="Joués ces 7 jours" Tag="last7Days"/>
                            <ComboBoxItem Content="Joués ces 30 jours" Tag="last30Days"/>
                            <ComboBoxItem Content="Mis à jour ces 7 jours" Tag="recentlyUpdated"/>
                        </ComboBox>

                        <ComboBox x:Name="TagFilter" Width="190" MaxDropDownHeight="400"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged"/>
                        <ToggleButton x:Name="FavoritesFilter" Content="★ Favoris" Margin="10,0,0,0" Padding="10,0"
              VerticalAlignment="Stretch"
              Checked="FavoritesFilter_Changed" Unchecked="FavoritesFilter_Changed"/>
                    </StackPanel>

                    <!-- Ligne 2 : plateformes à gauche, tri et compteur à droite -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right"
                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0"/>

                        <ComboBox x:Name="SortMode" DockPanel.Dock="Right" Width="170" Height="32"
                  VerticalAlignment="Top" Margin="10,0,0,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="SortMode_SelectionChanged">
                            <ComboBoxItem Content="Trier par nom" Tag="name"/>
                            <ComboBoxItem Content="Dernière partie" Tag="lastPlayed"/>
                            <ComboBoxItem Content="Temps de jeu" Tag="playtime"/>
                            <ComboBoxItem Content="Date de sortie" Tag="release"/>
                            <ComboBoxItem Content="Date d'ajout" Tag="added"/>
                            <ComboBoxItem Content="Taille sur le disque" Tag="size"/>
                            <ComboBoxItem Content="Succès (%)" Tag="achievements"/>
                        </ComboBox>
                        <Button x:Name="ManageCollectionsButton" DockPanel.Dock="Right" Content="Gérer…"
             Width="70" Height="32" VerticalAlignment="Top" Margin="6,0,0,0"
             Click="ManageCollectionsButton_Click"/>
                        <ComboBox x:Name="CollectionFilter" DockPanel.Dock="Right" Width="190" Height="32"
               VerticalAlignment="Top" Margin="10,0,0,0" VerticalContentAlignment="Center"
               MaxDropDownHeight="400" SelectionChanged="CollectionFilter_SelectionChanged"/>
                        <ComboBox x:Name="AchievementFilter" DockPanel.Dock="Right" Width="160" Height="32"
               VerticalAlignment="Top" Margin="10,0,0,0" SelectedIndex="0"
               VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tous les succès" Tag="all"/>
                            <ComboBoxItem Content="Succès à 100 %" Tag="complete"/>
                            <ComboBoxItem Content="Succès en cours" Tag="inProgress"/>
                            <ComboBoxItem Content="Succès ajoutés" Tag="newAchievements"/>
                            <ComboBoxItem Content="Jeux avec succès" Tag="withAchievements"/>
                            <ComboBoxItem Content="Jeux sans succès" Tag="withoutAchievements"/>
                        </ComboBox>
                        <WrapPanel x:Name="PlatformFilters"/>
                    </DockPanel>
                </StackPanel>
                <!-- Fiche détaillée du jeu sélectionné -->
                <!-- Son DataContext est choisi par le code (ShowDetails) : la tuile sélectionnée,
                     ou une autre copie du jeu choisie dans la liste « Plateforme ». -->
                <Border x:Name="DetailPanel" DockPanel.Dock="Right" Width="320" Margin="10,0,0,0" Padding="12"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        DataContext="{x:Null}">
                    <Grid>
                        <TextBlock Text="Sélectionne un jeu pour voir sa fiche."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel>
                                <Image local:CoverLoader.Path="{Binding CoverPath}"
                                       Width="200" Height="300" Stretch="UniformToFill"
                                       HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <!-- Jeu possédé sur plusieurs plateformes : choix de la copie (lancement, temps, succès) -->
                                <DockPanel x:Name="CopySelectorPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Plateforme" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="CopySelector" DisplayMemberPath="CopyLabel"
                                              SelectionChanged="CopySelector_SelectionChanged"/>
                                </DockPanel>
                                <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" Click="FavoriteButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="☆ Ajouter aux favoris"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Content" Value="★ Favori"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Background="#FFB300" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEarlyAccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Accès anticipé" FontWeight="SemiBold" Foreground="Black"/>
                                </Border>

                                <!-- Badges de la phase 5 : une ligne qui passe à la ligne si besoin -->
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Background="#2E7D32" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentlyUpdated}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Mis à jour" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>

                                    <Border Background="#FFC107" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="🏆 100 %" FontWeight="SemiBold" Foreground="Black"/>
                                    </Border>

                                    <Border Background="#E65100" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNewAchievements}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NewAchievementsText}" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>

                                <Button HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,4"
                                        Content="🏆 Voir les succès" Click="ShowAchievementsButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAchievements}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Statut" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallStatusText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Temps de jeu" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlaytimeText}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dernière partie" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPlayedText}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sortie" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseDateText}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Développeur" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Developers}" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Taille" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SizeText}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Succès" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AchievementsDetailText}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Mise à jour" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastUpdateText}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Collections" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <StackPanel x:Name="GameCollectionsPanel"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0"/>

                                <!-- Patch notes : remplies par le code quand on sélectionne un jeu -->
                                <TextBlock Text="Patch notes" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                <TextBlock x:Name="PatchNotesStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <ItemsControl x:Name="PatchNotesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}" Margin="0,0,0,8">
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Width="235"/>
                                                        <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Expander.Header>

                                                <StackPanel Margin="4,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                                                                    <TextBlock x:Name="Bullet" DockPanel.Dock="Left" Text="• "
                                                                               Visibility="Collapsed"/>
                                                                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                                                        <Setter TargetName="Bullet" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                                        <Setter TargetName="LineText" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="LineText" Property="Margin" Value="0,6,0,0"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Margin="0,4,0,0">
                                                        <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                                            Lire sur Steam
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="PatchNotesLinkButton" HorizontalAlignment="Left" Padding="10,4"
                                        Margin="0,4,0,0" Visibility="Collapsed" Click="PatchNotesLinkButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Grille de jaquettes -->
                <ListBox x:Name="GamesList"
                         SelectionChanged="GamesList_SelectionChanged"
                         MouseDoubleClick="GamesList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.CacheLength="1,1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="150" Margin="6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Height="225" Background="#2A2A2A">
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="8"/>
                                    <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                                    <Border Background="#AA000000" CornerRadius="12" Padding="6,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="★" Foreground="Gold" FontSize="16"/>
                                    </Border>

                                    <!-- Badge « Mis à jour » (en haut à gauche) -->
                                    <Border Background="#2E7D32" CornerRadius="10" Padding="6,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentlyUpdated}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Mis à jour" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Progression des succès (en bas à gauche) : « 🏆 37/50 », dorée à 100 %, orange si des succès ont été ajoutés -->
                                    <Border CornerRadius="10" Padding="6,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#CC000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAchievements}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                        <Setter Property="Background" Value="#FFC107"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasNewAchievements}" Value="True">
                                                        <Setter Property="Background" Value="#E65100"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding AchievementsText, StringFormat='🏆 {0}'}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                            <Setter Property="Text" Value="🏆 100 %"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Titre doré si au moins une copie du jeu est à 100 % -->
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnyCopyComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource CompleteTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Une pastille par plateforme si le jeu est possédé plusieurs fois (dorée = copie à 100 %).
                                     « Hidden » et pas « Collapsed » : la place reste réservée, toutes les tuiles ont la même hauteur. -->
                                <ItemsControl ItemsSource="{Binding CopyBadges}" Height="17" Margin="0,3,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOtherCopies}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Badge" CornerRadius="6" Padding="5,0" Margin="0,0,3,0"
                                                    Background="{DynamicResource SubtleBrush}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding Name}" FontSize="10"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter TargetName="Badge" Property="Background" Value="#FFC107"/>
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
        <!-- ===================== Onglet Statistiques ===================== -->
        <TabItem x:Name="StatsTab" Header="Statistiques">
            <TabItem.Resources>
                <!-- Le modèle d'une ligne de graphique : libellé, barre, valeur -->
                <DataTemplate x:Key="StatBarTemplate">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" Value="{Binding Ratio, Mode=OneWay}" Maximum="1" Height="14"
                                     Foreground="#4A90D9" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>

                <!-- Le style des titres de section -->
                <Style x:Key="StatTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,20,0,8"/>
                </Style>
            </TabItem.Resources>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">

                    <!-- Les chiffres clés -->
                    <WrapPanel>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalPlaytimeText}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="de jeu au total" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding GameCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="jeux dans la bibliothèque" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding InstalledCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="installés" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding PlayedCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="déjà joués" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding NeverPlayedCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="jamais lancés" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding FavoriteCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="favoris" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Top 10 des jeux les plus joués" Style="{StaticResource StatTitle}"/>
                    <ItemsControl ItemsSource="{Binding TopGames}" ItemTemplate="{StaticResource StatBarTemplate}"/>

                    <TextBlock Text="Temps de jeu par plateforme" Style="{StaticResource StatTitle}"/>
                    <ItemsControl ItemsSource="{Binding PlaytimeByPlatform}" ItemTemplate="{StaticResource StatBarTemplate}"/>

                    <TextBlock Text="Jeux par plateforme" Style="{StaticResource StatTitle}"/>
                    <ItemsControl ItemsSource="{Binding GamesByPlatform}" ItemTemplate="{StaticResource StatBarTemplate}"/>

                    <TextBlock Text="Temps de jeu par semaine" Style="{StaticResource StatTitle}"/>
                    <TextBlock Text="D'après les sessions lancées depuis Wyrmhold (hors Steam, qui compte le temps lui-même)."
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding PlaytimeByWeek}" ItemTemplate="{StaticResource StatBarTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!-- ===================== Onglet Comptes ===================== -->
        <TabItem Header="Comptes">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Comptes" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,20"
                               Text="Connecte tes comptes pour ajouter à ta bibliothèque les jeux que tu possèdes, même non installés. Une fois connecté, Wyrmhold se synchronise tout seul à chaque démarrage et à chaque actualisation."/>

                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Width" Value="140"/>
                                <Setter Property="Height" Value="32"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Famille Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamFamilyStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="SteamFamilyButton" Click="SteamFamilyButton_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GOG" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GogStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="2" Grid.Column="2" x:Name="GogAccountButton" Click="GogAccountButton_Click"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Epic Games" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EpicStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="3" Grid.Column="2" x:Name="EpicAccountButton" Click="EpicAccountButton_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ubisoft Connect" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UbisoftStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="4" Grid.Column="2" x:Name="UbisoftAccountButton" Click="UbisoftAccountButton_Click"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="EA app" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="EaStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="5" Grid.Column="2" x:Name="EaAccountButton" Click="EaAccountButton_Click"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Battle.net" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="BattleNetStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="6" Grid.Column="2" x:Name="BattleNetAccountButton" Click="BattleNetAccountButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== Onglet Réglages ===================== -->
        <TabItem Header="Réglages">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel.Resources>
                        <Style x:Key="SettingsSection" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,20,0,8"/>
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Réglages" FontSize="22" FontWeight="Bold"/>

                    <TextBlock Text="Apparence" Style="{StaticResource SettingsSection}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Clair" Margin="0,0,20,0"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Sombre"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>

                    <TextBlock Text="Bibliothèque" Style="{StaticResource SettingsSection}"/>
                    <CheckBox x:Name="MergeDuplicatesCheck"
                              Content="Regrouper un même jeu possédé sur plusieurs plateformes"
                              Checked="MergeDuplicatesCheck_Changed" Unchecked="MergeDuplicatesCheck_Changed"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Une seule tuile par jeu ; la liste « Plateforme » de la fiche choisit la copie à lancer. Les jeux sont reconnus par leur nom."/>

                    <TextBlock Text="Succès" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Décoche une plateforme pour que Wyrmhold arrête de lire ses succès. Les chiffres déjà connus restent affichés."/>
                    <CheckBox x:Name="SteamAchievementsCheck" Content="Steam" Tag="Steam" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="GogAchievementsCheck" Content="GOG" Tag="Gog" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="EpicAchievementsCheck" Content="Epic Games" Tag="Epic"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>