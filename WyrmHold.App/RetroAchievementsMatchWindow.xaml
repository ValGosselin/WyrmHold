<Window x:Class="WyrmHold.App.RetroAchievementsMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Loaded="Window_Loaded">

    <DockPanel Margin="14">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock x:Name="VersionsText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"/>

        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Height="32" Padding="6,0" VerticalContentAlignment="Center"
                 Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>

        <!-- En bas : les trois façons de décider, et Fermer (Échap marche aussi grâce à IsCancel) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="AutomaticButton" Content="Automatique" Height="32" Padding="12,0" Margin="0,0,8,0" Click="AutomaticButton_Click"/>
            <Button x:Name="NoGameButton" Content="Aucun jeu" Height="32" Padding="12,0" Click="NoGameButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ChooseButton" Content="Choisir ce jeu" Height="32" Padding="12,0" Margin="0,0,8,0"
                        IsDefault="True" IsEnabled="False" Click="ChooseButton_Click"/>
                <Button Content="Fermer" Width="90" Height="32" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Title, Mode=OneTime}"/>
                        <Run Text="·" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Run Text="{Binding AchievementCount, Mode=OneTime}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Run Text="succès" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
