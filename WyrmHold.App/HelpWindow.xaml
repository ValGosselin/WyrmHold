<!-- La fenêtre « Aide » de la fiche du jeu : un cadre autour de HelpPanel
     (le même panneau sert dans l'onglet « Aide » de l'overlay). -->
<Window x:Class="WyrmHold.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide" Height="820" Width="1280" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Le panneau d'aide, ajouté par le code (il a besoin du jeu) -->
    <ContentControl x:Name="PanelHost" Margin="14" Focusable="False"/>
</Window>
