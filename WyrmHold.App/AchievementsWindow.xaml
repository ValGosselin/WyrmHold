<!-- La fenêtre « Voir les succès » de la fiche du jeu : un cadre autour d'AchievementsPanel
     (le même panneau sert dans l'onglet « Succès » de l'overlay). -->
<Window x:Class="WyrmHold.App.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Succès" Height="680" Width="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <DockPanel Margin="14">
        <!-- En bas : fermer (Échap marche aussi grâce à IsCancel) -->
        <Button DockPanel.Dock="Bottom" Content="Fermer" Width="90" Height="32"
                HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>

        <!-- Le panneau des succès, ajouté par le code (il a besoin du jeu) -->
        <ContentControl x:Name="PanelHost" Focusable="False"/>
    </DockPanel>
</Window>
