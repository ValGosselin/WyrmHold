<!-- Palette sombre : les couleurs propres à Wyrmhold (le reste vient du thème Fluent de WPF).
     Chaque clé doit exister dans TOUTES les palettes, avec le même nom. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte secondaire : sous-titres, libellés, compteurs -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6A6A6"/>

    <!-- Texte des descriptions (succès) -->
    <SolidColorBrush x:Key="DescriptionTextBrush" Color="#C8C8C8"/>

    <!-- Fond des cartes de la page Statistiques -->
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>

    <!-- Fond discret : étiquettes de genre, rail des barres de progression -->
    <SolidColorBrush x:Key="SubtleBrush" Color="#3A3A3A"/>

    <!-- Bordure de la fiche du jeu -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F3F3F"/>

    <!-- Texte « Débloqué le … » -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#81C784"/>

    <!-- Titre d'un jeu à 100 % de succès (doré, lisible sur le fond du thème) -->
    <SolidColorBrush x:Key="CompleteTextBrush" Color="#FFD54F"/>

    <!-- Couleurs des plateformes et des consoles (anneaux de la page Statistiques). Clé : « Platform » + Game.FilterKey + « Brush ».
         Inspirées des marques, pour les reconnaître ; Epic en gris clair, car son noir disparaîtrait sur le fond sombre. -->
    <SolidColorBrush x:Key="PlatformSteamBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="PlatformEpicBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="PlatformUbisoftBrush" Color="#5C6BC0"/>
    <SolidColorBrush x:Key="PlatformGogBrush" Color="#AB47BC"/>
    <SolidColorBrush x:Key="PlatformEaBrush" Color="#FF5722"/>
    <SolidColorBrush x:Key="PlatformBattleNetBrush" Color="#00BCD4"/>
    <SolidColorBrush x:Key="PlatformGameBoyBrush" Color="#9CCC65"/>
    <SolidColorBrush x:Key="PlatformGameBoyColorBrush" Color="#FFCA28"/>
    <SolidColorBrush x:Key="PlatformGameBoyAdvanceBrush" Color="#26A69A"/>
    <SolidColorBrush x:Key="PlatformNintendoDsBrush" Color="#90A4AE"/>
    <SolidColorBrush x:Key="PlatformGameCubeBrush" Color="#7E57C2"/>
    <SolidColorBrush x:Key="PlatformWiiBrush" Color="#F48FB1"/>
    <SolidColorBrush x:Key="PlatformSwitchBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="PlatformNintendo3dsBrush" Color="#C2185B"/>
    <!-- Plateforme sans couleur à elle (nouvel émulateur, jeu émulé sans console connue) -->
    <SolidColorBrush x:Key="PlatformOtherBrush" Color="#8D6E63"/>
</ResourceDictionary>
