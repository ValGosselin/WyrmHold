<Window x:Class="WyrmHold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WyrmHold.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="WyrmHold" Height="450" Width="800"
        Loaded="Window_Loaded">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button x:Name="LogoutButton" Content="Se déconnecter de Steam" Width="170" Margin="0,0,10,0"
        Click="LogoutButton_Click"/>
            <Button x:Name="FamilyButton" Content="Bibliothèque familiale" Width="160" Margin="0,0,10,0"
                Click="FamilyButton_Click"/>
            <Button x:Name="RefreshButton" Content="Actualiser" Width="100" Margin="0,0,10,0"
                Click="RefreshButton_Click"/>
            <Button Content="Jouer" Width="100"
                Click="PlayButton_Click"/>
        </StackPanel>

        <ListBox x:Name="GamesList"
         MouseDoubleClick="GamesList_MouseDoubleClick"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         VirtualizingPanel.ScrollUnit="Pixel"
         VirtualizingPanel.VirtualizationMode="Recycling"
         VirtualizingPanel.CacheLengthUnit="Page"
         VirtualizingPanel.CacheLength="1,1">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Height="225" Background="#2A2A2A">
                            <TextBlock Text="{Binding Name}" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="8"/>
                            <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                        </Grid>

                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="Gray"
                           TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
