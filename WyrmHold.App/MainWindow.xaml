<Window x:Class="WyrmHold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WyrmHold.App"
        mc:Ignorable="d"
        Title="WyrmHold" Height="450" Width="800">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button Content="Actualiser" Width="100" Margin="0,0,10,0"
                Click="RefreshButton_Click"/>
            <Button Content="Jouer" Width="100"
                Click="PlayButton_Click"/>
        </StackPanel>

        <ListView x:Name="GamesList" MouseDoubleClick="GamesList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nom" Width="450"
                                DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Plateforme" Width="150"
                                DisplayMemberBinding="{Binding PlatformName}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
