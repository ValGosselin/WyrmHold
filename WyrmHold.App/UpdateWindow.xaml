<!-- La petite fenêtre du démarrage : elle cherche une mise à jour AVANT d'ouvrir Wyrmhold,
     pour qu'on n'utilise pas une ancienne version qui va être remplacée. -->
<Window x:Class="WyrmHold.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyrmhold" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- Ticket #10 : plus de barre bleue qui défile. L'œil du wyrm « respire » tant que la fenêtre est ouverte :
         l'œil s'éclaire puis s'assombrit, la pupille s'affine, une lueur ambre apparaît et disparaît (1,6 s, en boucle). -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <ColorAnimation Storyboard.TargetName="EyeBrush" Storyboard.TargetProperty="Color"
                                    From="#BA7517" To="#FAC775" Duration="0:0:1.6">
                        <ColorAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></ColorAnimation.EasingFunction>
                    </ColorAnimation>
                    <DoubleAnimation Storyboard.TargetName="PupilScale" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="0.55" Duration="0:0:1.6">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EyeGlow" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.6">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal">
            <!-- Le logo (Assets\logo.svg), redessiné ici pour pouvoir l'animer. Grille de 64 × 64. -->
            <Viewbox Width="56" Height="56" Margin="0,0,14,0">
                <Canvas Width="64" Height="64">
                    <Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14" Fill="#2C2C2A"/>
                    <Path Data="M8 32 C18 16 46 16 56 32 C46 48 18 48 8 32 Z">
                        <Path.Fill>
                            <SolidColorBrush x:Name="EyeBrush" Color="#BA7517"/>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect x:Name="EyeGlow" Color="#FAC775" ShadowDepth="0" BlurRadius="14" Opacity="0"/>
                        </Path.Effect>
                    </Path>
                    <!-- La pupille s'affine autour de son centre (32, 32). -->
                    <Path Data="M32 19 C25 26 25 38 32 45 C39 38 39 26 32 19 Z" Fill="#2C2C2A">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="PupilScale" CenterX="32" CenterY="32"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path Data="M14 18 L22 23 M50 18 L42 23" Stroke="#FAC775" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Wyrmhold" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="Recherche de mises à jour…" Margin="0,18,0,8" TextWrapping="Wrap"/>

        <!-- Cachée pendant la recherche (l'œil suffit), puis le pourcentage du téléchargement, aux couleurs du logo. -->
        <ProgressBar x:Name="Progress" Height="8" Maximum="100" Visibility="Collapsed"
                     Style="{StaticResource RoundedProgressBar}" Foreground="#E89A2C" Background="{DynamicResource SubtleBrush}"/>

        <!-- Le résumé de la version téléchargée : caché tant qu'il n'y en a pas -->
        <StackPanel x:Name="NotesPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="NotesTitle" FontSize="15" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                <StackPanel x:Name="NotesList"/>
            </ScrollViewer>
        </StackPanel>

        <Button x:Name="SkipButton" Content="Passer" HorizontalAlignment="Right" Padding="16,4" Margin="0,16,0,0"
                ToolTip="Ouvrir Wyrmhold sans attendre (la mise à jour sera cherchée au prochain démarrage)"
                Click="SkipButton_Click"/>
    </StackPanel>
</Window>
