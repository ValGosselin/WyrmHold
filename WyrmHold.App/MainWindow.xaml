<Window x:Class="WyrmHold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WyrmHold.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        PreviewKeyDown="Window_PreviewKeyDown"
        MinWidth="1150" MinHeight="650"
        mc:Ignorable="d"
        Title="Wyrmhold" Height="750" Width="1200"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- true → visible, false → caché (menu clic droit des tuiles : options des jeux installés) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Valeur d'une ligne d'infos de la fiche : cachée quand elle est vide -->
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs" Margin="10" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ===================== Onglet Bibliothèque ===================== -->
        <TabItem Header="Bibliothèque">
            <DockPanel Margin="10">

                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="32">
                    <!-- À droite : les boutons d'action, comme avant -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ThemeButton" Width="46" Margin="0,0,10,0"
                                Click="ThemeButton_Click"/>
                        <Button Content="🎲 Jeu au hasard" Width="130" Margin="0,0,10,0"
                                Click="RandomGameButton_Click"/>
                        <Button x:Name="RefreshButton" Content="Actualiser" Width="100" Margin="0,0,10,0"
                                Click="RefreshButton_Click"/>
                        <!-- Le bouton principal : couleur d'accent du thème Fluent (DynamicResource, car le thème
                             est choisi par le code au démarrage). Son texte suit le jeu choisi (UpdatePlayButton). -->
                        <Button x:Name="PlayButton" Content="▶ Jouer" Width="110"
                                Style="{DynamicResource AccentButtonStyle}"
                                ToolTipService.ShowOnDisabled="True"
                                Click="PlayButton_Click"/>
                    </StackPanel>

                    <!-- À gauche : les vues enregistrées -->
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SavedViewsList" Width="220" VerticalContentAlignment="Center"
                                  SelectionChanged="SavedViewsList_SelectionChanged"/>
                        <Button Content="Enregistrer la vue…" Width="140" Margin="10,0,0,0"
                                Click="SaveViewButton_Click"/>
                        <Button Content="Supprimer la vue" Width="129" Margin="6,0,0,0"
                                Click="DeleteViewButton_Click"/>
                    </StackPanel>
                </DockPanel>
                <!-- Barre de recherche et filtres -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

                    <!-- Ligne 1 : recherche et filtres -->
                    <StackPanel Orientation="Horizontal" Height="32">
                        <Grid Width="220" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Padding="6,0" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="Rechercher un jeu…" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="InstallFilter" Width="130" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tous les jeux" Tag="all"/>
                            <ComboBoxItem Content="Installés" Tag="installed"/>
                            <ComboBoxItem Content="Non installés" Tag="notInstalled"/>
                        </ComboBox>

                        <ComboBox x:Name="OriginFilter" Width="150" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Toutes origines" Tag="all"/>
                            <ComboBoxItem Content="À moi" Tag="mine"/>
                            <ComboBoxItem Content="Famille Steam" Tag="family"/>
                        </ComboBox>

                        <ComboBox x:Name="ActivityFilter" Width="170" Margin="0,0,10,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Toute activité" Tag="all"/>
                            <ComboBoxItem Content="Jamais lancés" Tag="neverPlayed"/>
                            <ComboBoxItem Content="Moins d'1 h de jeu" Tag="underOneHour"/>
                            <ComboBoxItem Content="Plus de 10 h de jeu" Tag="overTenHours"/>
                            <ComboBoxItem Content="Joués ces 7 jours" Tag="last7Days"/>
                            <ComboBoxItem Content="Joués ces 30 jours" Tag="last30Days"/>
                            <ComboBoxItem Content="Mis à jour ces 7 jours" Tag="recentlyUpdated"/>
                        </ComboBox>

                        <ComboBox x:Name="TagFilter" Width="190" MaxDropDownHeight="400"
                  VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged"/>
                        <ToggleButton x:Name="FavoritesFilter" Content="★ Favoris" Margin="10,0,0,0" Padding="10,0"
              VerticalAlignment="Stretch"
              Checked="FavoritesFilter_Changed" Unchecked="FavoritesFilter_Changed"/>
                    </StackPanel>

                    <!-- Ligne 2 : plateformes à gauche, tri et compteur à droite -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right"
                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,0,0"/>

                        <ComboBox x:Name="SortMode" DockPanel.Dock="Right" Width="170" Height="32"
                  VerticalAlignment="Top" Margin="10,0,0,0" SelectedIndex="0"
                  VerticalContentAlignment="Center" SelectionChanged="SortMode_SelectionChanged">
                            <ComboBoxItem Content="Trier par nom" Tag="name"/>
                            <ComboBoxItem Content="Dernière partie" Tag="lastPlayed"/>
                            <ComboBoxItem Content="Temps de jeu" Tag="playtime"/>
                            <ComboBoxItem Content="Date de sortie" Tag="release"/>
                            <ComboBoxItem Content="Date d'ajout" Tag="added"/>
                            <ComboBoxItem Content="Taille sur le disque" Tag="size"/>
                            <ComboBoxItem Content="Succès (%)" Tag="achievements"/>
                        </ComboBox>
                        <Button x:Name="ManageCollectionsButton" DockPanel.Dock="Right" Content="Gérer…"
             Width="70" Height="32" VerticalAlignment="Top" Margin="6,0,0,0"
             Click="ManageCollectionsButton_Click"/>
                        <ComboBox x:Name="CollectionFilter" DockPanel.Dock="Right" Width="190" Height="32"
               VerticalAlignment="Top" Margin="10,0,0,0" VerticalContentAlignment="Center"
               MaxDropDownHeight="400" SelectionChanged="CollectionFilter_SelectionChanged"/>
                        <ComboBox x:Name="AchievementFilter" DockPanel.Dock="Right" Width="160" Height="32"
               VerticalAlignment="Top" Margin="10,0,0,0" SelectedIndex="0"
               VerticalContentAlignment="Center" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tous les succès" Tag="all"/>
                            <ComboBoxItem Content="Succès à 100 %" Tag="complete"/>
                            <ComboBoxItem Content="Succès en cours" Tag="inProgress"/>
                            <ComboBoxItem Content="Succès ajoutés" Tag="newAchievements"/>
                            <ComboBoxItem Content="Jeux avec succès" Tag="withAchievements"/>
                            <ComboBoxItem Content="Jeux sans succès" Tag="withoutAchievements"/>
                        </ComboBox>
                        <WrapPanel x:Name="PlatformFilters"/>
                    </DockPanel>

                    <!-- Bandeau « nouveaux succès » : affiché après la lecture des succès si des mises à jour
                         en ont ajouté (rempli par MainWindow.ShowAddedAchievements). -->
                    <Border x:Name="AddedAchievementsBanner" Background="#E65100" CornerRadius="6"
                            Padding="12,6" Margin="0,8,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0"
                                    ToolTip="Fermer" Click="AddedAchievementsClose_Click"/>
                            <Button DockPanel.Dock="Right" Content="Voir ces jeux" Padding="10,2" Margin="8,0,0,0"
                                    Click="AddedAchievementsShow_Click"/>
                            <TextBlock x:Name="AddedAchievementsText" Foreground="White" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <!-- Fiche détaillée du jeu sélectionné -->
                <!-- Son DataContext est choisi par le code (ShowDetails) : la tuile sélectionnée,
                     ou une autre copie du jeu choisie dans la liste « Plateforme ». -->
                <Border x:Name="DetailPanel" DockPanel.Dock="Right" Width="320" Margin="10,0,0,0" Padding="12"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        DataContext="{x:Null}">
                    <Grid>
                        <TextBlock Text="Sélectionne un jeu pour voir sa fiche."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Padding : le thème Fluent pose la barre (12 pixels) par-dessus le contenu, sans lui
                             garder de place. Même réglage sur les autres zones qui défilent jusqu'au bord. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel>
                                <Image local:CoverLoader.Path="{Binding CoverPath}"
                                       Width="200" Height="300" Stretch="UniformToFill"
                                       HorizontalAlignment="Center"/>

                                <!-- Le nom, et à sa droite l'étoile des favoris : jaune si le jeu est favori, vide sinon -->
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                                            Padding="6,0" FontSize="20" Background="Transparent" BorderThickness="0"
                                            Click="FavoriteButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="☆"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Setter Property="ToolTip" Value="Ajouter aux favoris"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Content" Value="★"/>
                                                        <Setter Property="Foreground" Value="Gold"/>
                                                        <Setter Property="ToolTip" Value="Retirer des favoris"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <!-- Jeu possédé sur plusieurs plateformes : choix de la copie (lancement, temps, succès) -->
                                <DockPanel x:Name="CopySelectorPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Plateforme" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="CopySelector" DisplayMemberPath="CopyLabel"
                                              SelectionChanged="CopySelector_SelectionChanged"/>
                                </DockPanel>

                                <Border Background="#FFB300" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEarlyAccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Accès anticipé" FontWeight="SemiBold" Foreground="Black"/>
                                </Border>

                                <!-- Badges de la phase 5 : une ligne qui passe à la ligne si besoin -->
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Background="#2E7D32" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecentlyUpdated}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Mis à jour" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>

                                    <Border Background="#FFC107" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="🏆 100 %" FontWeight="SemiBold" Foreground="Black"/>
                                    </Border>

                                    <Border Background="#E65100" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAddedAchievements}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NewAchievementsText}" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>

                                <WrapPanel Margin="0,4,0,0">
                                    <Button Margin="0,0,8,4" Padding="10,4"
                                            Content="🏆 Voir les succès" Click="ShowAchievementsButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAchievements}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </WrapPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Statut" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallStatusText}"/>

                                    <!-- Une ligne sans valeur disparaît : la valeur se cache toute seule (InfoValue),
                                         et son libellé suit grâce à la liaison sur sa Visibility. -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Temps de jeu" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=PlaytimeValue}"/>
                                    <TextBlock x:Name="PlaytimeValue" Grid.Row="1" Grid.Column="1" Text="{Binding PlaytimeText}" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dernière partie" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=LastPlayedValue}"/>
                                    <TextBlock x:Name="LastPlayedValue" Grid.Row="2" Grid.Column="1" Text="{Binding LastPlayedText}" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sortie" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=ReleaseDateValue}"/>
                                    <TextBlock x:Name="ReleaseDateValue" Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseDateText}" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Développeur" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=DevelopersValue}"/>
                                    <TextBlock x:Name="DevelopersValue" Grid.Row="4" Grid.Column="1" Text="{Binding Developers}" TextWrapping="Wrap" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Taille" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=SizeValue}"/>
                                    <TextBlock x:Name="SizeValue" Grid.Row="5" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Succès" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=AchievementsValue}"/>
                                    <TextBlock x:Name="AchievementsValue" Grid.Row="6" Grid.Column="1" Text="{Binding AchievementsDetailText}" Style="{StaticResource InfoValue}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Mise à jour" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,4"
                                               Visibility="{Binding Visibility, ElementName=LastUpdateValue}"/>
                                    <TextBlock x:Name="LastUpdateValue" Grid.Row="7" Grid.Column="1" Text="{Binding LastUpdateText}" Style="{StaticResource InfoValue}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Clic sur un tag = les promos de ce tag dans Boutiques (avec la clé IsThereAnyDeal).
                                                 Le tag (un texte) est rangé dans Tag : le code le relit au clic. -->
                                            <Button Tag="{Binding}" Click="GameTag_Click" Cursor="Hand" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Margin="0,0,6,6"
                                                    ToolTip="Voir les jeux avec ce tag dans Boutique">
                                                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="8,2">
                                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Collections" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <StackPanel x:Name="GameCollectionsPanel"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0"/>

                                <!-- Jeux similaires (selon la boutique Steam), sans ceux que tu possèdes : remplis par le code.
                                     Clic = la page Boutiques sur ce jeu (s'il y a la clé IsThereAnyDeal). -->
                                <StackPanel x:Name="SimilarGamesPanel" Visibility="Collapsed">
                                    <DockPanel Margin="0,16,0,6">
                                        <!-- ↻ : les 3 jeux similaires suivants (caché s'il n'y en a pas d'autres) -->
                                        <Button x:Name="MoreSimilarGamesButton" DockPanel.Dock="Right" Content="↻" Padding="8,0"
                                                ToolTip="Proposer 3 autres jeux" Click="MoreSimilarGamesButton_Click"/>
                                        <TextBlock Text="Jeux similaires" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="SimilarGamesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Le jeu est rangé dans Tag : le code le relit au clic. -->
                                                <Button Tag="{Binding}" Click="SimilarGame_Click" Margin="0,0,0,6" Padding="4"
                                                        HorizontalContentAlignment="Stretch" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand">
                                                    <DockPanel>
                                                        <Image DockPanel.Dock="Left" Width="110" Height="63" Stretch="UniformToFill"
                                                               Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                               local:WebImageLoader.DecodeWidth="220"
                                                               local:WebImageLoader.Url="{Binding ImageUrl}"/>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="SimilarGamesHint" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Ajoute ta clé IsThereAnyDeal (Réglages → Clés API) pour ouvrir leurs prix dans Boutique."/>
                                </StackPanel>

                                <!-- Patch notes : remplies par le code quand on sélectionne un jeu -->
                                <TextBlock Text="Patch notes" FontWeight="SemiBold" Margin="0,16,0,4"/>
                                <TextBlock x:Name="PatchNotesStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <ItemsControl x:Name="PatchNotesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}" Margin="0,0,0,8">
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Width="235"
                                                                   HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Expander.Header>

                                                <StackPanel Margin="4,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                                                                    <TextBlock x:Name="Bullet" DockPanel.Dock="Left" Text="• "
                                                                               Visibility="Collapsed"/>
                                                                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                                                        <Setter TargetName="Bullet" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                                        <Setter TargetName="LineText" Property="FontWeight" Value="Bold"/>
                                                                        <Setter TargetName="LineText" Property="Margin" Value="0,6,0,0"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Margin="0,4,0,0">
                                                        <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                                            Lire sur Steam
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="PatchNotesLinkButton" HorizontalAlignment="Left" Padding="10,4"
                                        Margin="0,4,0,0" Visibility="Collapsed" Click="PatchNotesLinkButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Grille de jaquettes, et par-dessus le message affiché quand elle est vide (UpdateEmptyLibraryMessage) -->
                <Grid>
                <ListBox x:Name="GamesList"
                         SelectionChanged="GamesList_SelectionChanged"
                         MouseDoubleClick="GamesList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.CacheLength="0.25,0.25">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="150" Margin="6">
                                <!-- Clic droit sur la tuile. Le menu reçoit le jeu de la tuile (DataContext) tout seul. -->
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="TileMenuPlay_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="▶  Jouer"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                            <Setter Property="Header" Value="⬇  Installer"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- Rempli à l'ouverture (TileMenuCollections_SubmenuOpened). La ligne de départ
                                             sert seulement à afficher la flèche du sous-menu. -->
                                        <MenuItem Header="🗂  Collections" SubmenuOpened="TileMenuCollections_SubmenuOpened">
                                            <MenuItem Header="…"/>
                                        </MenuItem>
                                        <MenuItem Click="TileMenuFavorite_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="★  Ajouter aux favoris"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Header" Value="☆  Retirer des favoris"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <!-- Ces deux-là : seulement pour un jeu installé -->
                                        <MenuItem Header="🖼  Re-télécharger la jaquette" Click="TileMenuRedownloadCover_Click"/>
                                        <MenuItem Header="📁  Ouvrir le dossier du jeu" Click="TileMenuOpenFolder_Click"
                                                  Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="🏆  Jeu RetroAchievements…" Click="TileMenuRetroAchievements_Click"
                                                  Visibility="{Binding CanHaveRetroAchievements, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- Pas pour un jeu émulé : Wyrmhold ne supprime jamais de fichier lui-même -->
                                        <Separator Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="🗑  Désinstaller…" Click="TileMenuUninstall_Click"
                                                  Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Height="225" Background="#2A2A2A">
                                    <!-- Le nom à la place de la jaquette, seulement pour un jeu qui n'en a pas : calculer
                                         ce texte derrière chaque image coûtait plus de la moitié du temps de chaque tuile
                                         (mesuré le 2 novembre 2026). -->
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>

                                    <!-- En haut de la jaquette. 1re ligne : l'étoile des favoris à gauche, les joueurs en jeu à droite
                                         (si les deux ne tiennent pas, le chiffre finit par « … » ; l'infobulle le donne en entier).
                                         2e ligne, à gauche : « Mis à jour ». -->
                                    <StackPanel VerticalAlignment="Top" Margin="6,6,6,0">
                                        <!-- Hauteur fixe : avec ou sans l'étoile, plus haute que le badge, rien ne bouge. -->
                                        <DockPanel LastChildFill="True" Height="24">
                                            <Border DockPanel.Dock="Left" Background="#AA000000" CornerRadius="12" Padding="6,1" Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="★" Foreground="Gold" FontSize="16"/>
                                            </Border>
                                    
                                            <!-- Joueurs en jeu en ce moment sur Steam : pastille verte (dessinée : WPF afficherait
                                                 l'emoji 🟢 en noir et blanc) + « 22,1 k en jeu » (« · Steam » pour un jeu acheté ailleurs). -->
                                            <Border Background="#CC000000" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" ToolTip="{Binding PlayersInGameToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPlayersInGame}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                                    <TextBlock Text="{Binding PlayersInGameText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                        </DockPanel>
                                    
                                        <!-- Badge « Mis à jour » -->
                                        <Border Background="#2E7D32" CornerRadius="10" Padding="6,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecentlyUpdated}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Mis à jour" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Progression des succès (en bas à gauche) : coupe + « 37/50 », dorée à 100 %, orange si des succès
                                         ont été ajoutés. La coupe est dessinée : l'emoji 🏆 forçait WPF à chercher une police de secours
                                         à chaque tuile, ce qui coûtait très cher au défilement (mesuré le 2 novembre 2026). -->
                                    <Border CornerRadius="10" Padding="6,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#CC000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAchievements}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                        <Setter Property="Background" Value="#FFC107"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasAddedAchievements}" Value="True">
                                                        <Setter Property="Background" Value="#E65100"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="10" Height="10" Margin="0,0,4,0" Stretch="Uniform" VerticalAlignment="Center"
                                                  Data="M4,1 H12 V2 H15 V5 C15,7 13,8 11.5,8.2 C11,9.5 10,10.2 9,10.5 V12 H11 V14 H5 V12 H7 V10.5 C6,10.2 5,9.5 4.5,8.2 C3,8 1,7 1,5 V2 H4 Z"
                                                  Fill="{Binding Foreground, ElementName=AchievementsBadgeText}"/>
                                            <TextBlock x:Name="AchievementsBadgeText" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding AchievementsText}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAchievementsComplete}" Value="True">
                                                                <Setter Property="Text" Value="100 %"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </DataTrigger>
                                                            <!-- Succès ajoutés pas encore regardés : « 37/60 · +10 » sur fond orange -->
                                                            <DataTrigger Binding="{Binding HasAddedAchievements}" Value="True">
                                                                <Setter Property="Text" Value="{Binding AddedAchievementsTileText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Titre doré si au moins une copie du jeu est à 100 % -->
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnyCopyComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource CompleteTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Une pastille par plateforme si le jeu est possédé plusieurs fois (dorée = copie à 100 %).
                                     « Hidden » et pas « Collapsed » : la place reste réservée, toutes les tuiles ont la même hauteur.
                                     ItemsSource seulement dans le déclencheur : sans pastille à montrer, rien n'est créé, ce qui
                                     allège le défilement (presque tous les jeux n'ont qu'une copie). -->
                                <ItemsControl Height="17" Margin="0,3,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOtherCopies}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="ItemsSource" Value="{Binding CopyBadges}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Badge" CornerRadius="6" Padding="5,0" Margin="0,0,3,0"
                                                    Background="{DynamicResource SubtleBrush}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding Name}" FontSize="10"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter TargetName="Badge" Property="Background" Value="#FFC107"/>
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyLibraryPanel" Visibility="Collapsed" MaxWidth="420"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyLibraryText" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyLibraryHint" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button x:Name="ClearFiltersButton" Content="Effacer la recherche et les filtres"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Padding="12,6"
                            Click="ClearFiltersButton_Click"/>
                </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>
        <!-- ===================== Onglet Statistiques ===================== -->
        <TabItem x:Name="StatsTab" Header="Statistiques">
            <TabItem.Resources>
                <!-- Le modèle d'une ligne de graphique : libellé, barre, valeur -->
                <DataTemplate x:Key="StatBarTemplate">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="1" Value="{Binding Ratio, Mode=OneWay}" Maximum="1" Height="14"
                                     Style="{StaticResource RoundedProgressBar}" Foreground="#4A90D9" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>

                <!-- Une ligne du Top 10 : jaquette, nom, barre, temps de jeu -->
                <DataTemplate x:Key="TopGameTemplate">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Fond gris sous la jaquette : un jeu sans image garde sa place -->
                        <Border Grid.Column="0" Width="28" Height="42" CornerRadius="3" Margin="0,0,10,0"
                                Background="{DynamicResource SubtleBrush}" ClipToBounds="True">
                            <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar Grid.Column="2" Value="{Binding Ratio, Mode=OneWay}" Maximum="1" Height="14"
                                     Style="{StaticResource RoundedProgressBar}" Foreground="#4A90D9" Background="{DynamicResource SubtleBrush}" BorderThickness="0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ValueText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>

                <local:BrushKeyConverter x:Key="BrushKey"/>
                <local:ScaleConverter x:Key="Scale"/>

                <!-- Une ligne de légende d'anneau : carré de couleur, nom, valeur, pourcentage -->
                <DataTemplate x:Key="SliceLegendTemplate">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="12" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Fill="{Binding BrushKey, Converter={StaticResource BrushKey}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </DataTemplate>

                <!-- Une ligne du panneau de chiffres : la valeur à droite d'une colonne fixe, puis son libellé -->
                <Style x:Key="StatNumber" TargetType="TextBlock">
                    <Setter Property="Width" Value="80"/>
                    <Setter Property="TextAlignment" Value="Right"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
                <Style x:Key="StatNumberLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </Style>
                <Style x:Key="StatSeparator" TargetType="Border">
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="0,8"/>
                    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                </Style>

                <!-- Le style des titres de section -->
                <Style x:Key="StatTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,20,0,8"/>
                </Style>
            </TabItem.Resources>

            <!-- Padding à droite : la barre de défilement Fluent passe par-dessus le contenu sinon (voir CLAUDE.md) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                <StackPanel Margin="16">

                    <!-- ===== Succès (façon completionist.me) ===== -->
                    <TextBlock Text="Succès" Style="{StaticResource StatTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <!-- Les trois grandes cartes -->
                            <UniformGrid Columns="3">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,10,10" Height="160">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AchievementsUnlockedText}" FontSize="40" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource CompleteTextBrush}"/>
                                        <TextBlock Text="succès débloqués" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,10,10" Height="160">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                                            <local:DonutChart Slices="{Binding CompletionRing}" Thickness="9"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Text="{Binding AverageCompletionRoundText}" FontSize="30" FontWeight="Bold"/>
                                                <TextBlock Text="%" FontSize="14" Margin="2,0,0,5" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="complétion moyenne" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,10" Height="160">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PerfectCount}" FontSize="40" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource CompleteTextBrush}"/>
                                        <TextBlock Text="jeux à 100 %" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Deux graphiques sur la même carte, par onglets (comme completionist.me) -->
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,8,16,12">
                                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                                <!-- Onglet 1 : combien de jeux dans chaque tranche de complétion -->
                                <TabItem Header="Complétion des jeux">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap">
                                        <Run Text="Jeux à succès lancés au moins une fois :"/>
                                        <Run Text="{Binding CompletionGameCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding CompletionBuckets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Hauteur fixe : les colonnes partent toutes du même bas -->
                                                <DockPanel Height="190" Margin="3,0">
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" HorizontalAlignment="Center"
                                                               FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,2"/>
                                                        <Border Height="{Binding Ratio, Converter={StaticResource Scale}, ConverterParameter=150}"
                                                                CornerRadius="3,3,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#4A90D9"/>
                                                                    <Style.Triggers>
                                                                        <!-- La colonne 100 % en doré, comme les jeux terminés -->
                                                                        <DataTrigger Binding="{Binding IsPerfect}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource CompleteTextBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </TabItem>

                                <!-- Onglet 2 : combien de tes succès dans chaque niveau de rareté -->
                                <TabItem Header="Rareté des succès">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding RarityKnownText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding RarityBuckets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Même hauteur que l'onglet Complétion (190 + libellé) : la carte ne saute pas d'un onglet à l'autre -->
                                                <DockPanel Height="190" Margin="6,0">
                                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="11"/>
                                                        <TextBlock Text="{Binding Range}" HorizontalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,2"/>
                                                        <Border Height="{Binding Ratio, Converter={StaticResource Scale}, ConverterParameter=130}"
                                                                CornerRadius="3,3,0,0">
                                                            <Border.Style>
                                                                <!-- Du bleu (très commun) vers le doré (ultra rare) -->
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#4A90D9"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Background" Value="#3FA7C9"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Background" Value="#43B89F"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Background" Value="#8BC34A"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="4"><Setter Property="Background" Value="#FFB300"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="5"><Setter Property="Background" Value="{DynamicResource CompleteTextBrush}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </TabItem>
                                </TabControl>
                            </Border>
                        </StackPanel>

                        <!-- Le panneau de chiffres -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" MinWidth="320">
                            <StackPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding AchievementsUnlockedText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="succès débloqués"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding RemainingInStartedText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="restants dans les jeux commencés"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding RemainingInUntouchedText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="restants dans les jeux jamais touchés"/></DockPanel>
                                <Border Style="{StaticResource StatSeparator}"/>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding AverageCompletionText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="complétion moyenne"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding MedianCompletionText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="complétion médiane"/></DockPanel>
                                <Border Style="{StaticResource StatSeparator}"/>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource StatNumber}" Text="{Binding BestDayCount}"/>
                                    <TextBlock Style="{StaticResource StatNumberLabel}">
                                        <Run Text="record sur un jour ("/><Run Text="{Binding BestDayText, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding DailyAverageText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="par jour, en moyenne (jours avec succès)"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding AverageRarityText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="de joueurs, en moyenne, ont tes succès"/></DockPanel>
                                <Border Style="{StaticResource StatSeparator}"/>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding GamesWithAchievements}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="jeux avec succès"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding StartedCount}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="… commencés"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding InProgressCount}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="… en cours"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding PerfectCount}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="… à 100 %"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding UntouchedCount}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="… jamais touchés"/></DockPanel>
                                <Border Style="{StaticResource StatSeparator}"/>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding TotalPlaytimeText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="de jeu au total"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding AveragePlaytimeText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="en moyenne par jeu joué"/></DockPanel>
                                <DockPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding MedianPlaytimeText}"/><TextBlock Style="{StaticResource StatNumberLabel}" Text="médiane par jeu joué"/></DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Historique : une case par jour, avec le nombre de succès ===== -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" Margin="0,10,0,0"
                            DataContext="{Binding Calendar}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <!-- Les flèches pour changer d'année -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="◀" Padding="10,2" Click="CalendarPreviousYear_Click" IsEnabled="{Binding CanGoPrevious}"
                                            ToolTip="Année précédente"/>
                                    <TextBlock Text="{Binding YearText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Content="▶" Padding="10,2" Click="CalendarNextYear_Click" IsEnabled="{Binding CanGoNext}"
                                            ToolTip="Année suivante"/>
                                </StackPanel>
                                <TextBlock Text="Historique" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding YearCountText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>

                            <!-- Le calendrier se réduit si la fenêtre est trop étroite, sans jamais grossir -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Les jours de la semaine, à gauche (une ligne sur deux, comme GitHub) -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Height="22" FontSize="10" VerticalAlignment="Center" Padding="0,4,0,0" Text="lun." Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Height="22"/>
                                        <TextBlock Height="22" FontSize="10" Padding="0,4,0,0" Text="mer." Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Height="22"/>
                                        <TextBlock Height="22" FontSize="10" Padding="0,4,0,0" Text="ven." Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Height="22"/>
                                        <TextBlock Height="22" FontSize="10" Padding="0,4,0,0" Text="dim." Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Les mois, au-dessus de la semaine qui contient leur 1er jour.
                                         Un Canvas ne coupe pas le texte : « janv. » peut déborder sur la semaine suivante, qui n'a pas de nom. -->
                                    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Weeks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Canvas Width="22" Height="16">
                                                    <TextBlock Text="{Binding MonthLabel}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Les semaines (colonnes) et leurs jours (cases) -->
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Weeks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Days}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="20" Height="20" Margin="1" ToolTip="{Binding ToolTip}">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <!-- Jour d'une autre année : place gardée, case invisible -->
                                                                            <DataTrigger Binding="{Binding IsInYear}" Value="False">
                                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="3"/>
                                                                <!-- La couleur, plus intense quand il y a plus de succès -->
                                                                <Border Background="#4A90D9" CornerRadius="3">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Opacity" Value="0.3"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Opacity" Value="0.75"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="4"><Setter Property="Opacity" Value="1"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <TextBlock Text="{Binding CountText}" FontSize="9" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <!-- Remplissage de l'historique en cours (lecture complète unique en arrière-plan) -->
                    <TextBlock Text="{Binding HistoryStatusText}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="{Binding IsHistoryIncomplete, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="Les succès maison des jeux émulés (Switch, 3DS) n'ont pas de date : ils ne sont pas dans l'historique."
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <!-- ===== Jeux récents : le dernier succès de chaque jeu ===== -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Jeux récents" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6" TextElement.Foreground="{DynamicResource SecondaryTextBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Jeu"/>
                                <TextBlock Grid.Column="2" Text="Progression"/>
                                <TextBlock Grid.Column="3" Text="Succès" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Temps de jeu" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Dernier succès" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="42" CornerRadius="3" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SubtleBrush}" ClipToBounds="True">
                                                <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SourceName}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="2" Value="{Binding Ratio, Mode=OneWay}" Maximum="1" Height="10"
                                                         VerticalAlignment="Center" BorderThickness="0"
                                                         Background="{DynamicResource SubtleBrush}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource RoundedProgressBar}">
                                                        <Setter Property="Foreground" Value="#4A90D9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPerfect}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CompleteTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="3" Text="{Binding ProgressText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PlaytimeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding LastUnlockText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== Tes succès les plus rares ===== -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Tes succès les plus rares" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding RarestUnlocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="42" CornerRadius="3" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SubtleBrush}" ClipToBounds="True">
                                                <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding RarityText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource CompleteTextBrush}"
                                                       ToolTip="Part des joueurs du jeu qui ont ce succès"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DateText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== Bibliothèque ===== -->
                    <TextBlock Text="Bibliothèque" Style="{StaticResource StatTitle}"/>

                    <!-- Les chiffres clés -->
                    <WrapPanel>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalPlaytimeText}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="de jeu au total" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding GameCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="jeux dans la bibliothèque" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding InstalledCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="installés" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding PlayedCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="déjà joués" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding NeverPlayedCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="jamais lancés" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding FavoriteCount}" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="favoris" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Top 10 des jeux les plus joués" Style="{StaticResource StatTitle}"/>
                    <ItemsControl ItemsSource="{Binding TopGames}" ItemTemplate="{StaticResource TopGameTemplate}"/>

                    <!-- Les deux anneaux par plateforme, côte à côte s'il y a la place -->
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" Margin="0,10,10,0">
                            <StackPanel>
                                <TextBlock Text="Temps de jeu par plateforme" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:DonutChart Slices="{Binding PlaytimeByPlatform}" Width="170" Height="170" Thickness="26"
                                                      VerticalAlignment="Top" Margin="0,0,20,0"/>
                                    <ItemsControl ItemsSource="{Binding PlaytimeByPlatform}" ItemTemplate="{StaticResource SliceLegendTemplate}"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="16,12" Margin="0,10,10,0">
                            <StackPanel>
                                <TextBlock Text="Jeux par plateforme" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <local:DonutChart Slices="{Binding GamesByPlatform}" Width="170" Height="170" Thickness="26"
                                                      VerticalAlignment="Top" Margin="0,0,20,0"/>
                                    <ItemsControl ItemsSource="{Binding GamesByPlatform}" ItemTemplate="{StaticResource SliceLegendTemplate}"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Temps de jeu par semaine" Style="{StaticResource StatTitle}"/>
                    <TextBlock Text="D'après les sessions lancées depuis Wyrmhold (hors Steam, qui compte le temps lui-même)."
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding PlaytimeByWeek}" ItemTemplate="{StaticResource StatBarTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!-- ===================== Onglet Boutiques ===================== -->
        <!-- Son contenu est dans ShopsView.xaml (un UserControl), pour ne pas alourdir ce fichier. -->
        <TabItem x:Name="ShopsTab" Header="Boutique">
            <local:ShopsView x:Name="ShopsPanel"/>
        </TabItem>

        <!-- ===================== Onglet Comptes ===================== -->
        <TabItem Header="Comptes">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Comptes" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,20"
                               Text="Connecte tes comptes pour ajouter à ta bibliothèque les jeux que tu possèdes, même non installés. Une fois connecté, Wyrmhold se synchronise tout seul à chaque démarrage et à chaque actualisation."/>

                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Width" Value="140"/>
                                <Setter Property="Height" Value="32"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Famille Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamFamilyStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="SteamFamilyButton" Click="SteamFamilyButton_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GOG" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GogStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="2" Grid.Column="2" x:Name="GogAccountButton" Click="GogAccountButton_Click"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Epic Games" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EpicStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="3" Grid.Column="2" x:Name="EpicAccountButton" Click="EpicAccountButton_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ubisoft Connect" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UbisoftStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="4" Grid.Column="2" x:Name="UbisoftAccountButton" Click="UbisoftAccountButton_Click"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="EA app" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="EaStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="5" Grid.Column="2" x:Name="EaAccountButton" Click="EaAccountButton_Click"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Battle.net" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="BattleNetStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="6" Grid.Column="2" x:Name="BattleNetAccountButton" Click="BattleNetAccountButton_Click"/>

                        <!-- Facultatif : synchronise la liste de suivi de l'onglet Boutiques avec ta Waitlist -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="IsThereAnyDeal" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ItadStatusText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="7" Grid.Column="2" x:Name="ItadAccountButton" Click="ItadAccountButton_Click"/>

                        <!-- Émulateurs : Tag = le nom de la plateforme (énumération Platform). -->
                        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Margin="0,24,0,6">
                            <TextBlock Text="Émulateurs" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Wyrmhold lit les dossiers de jeux de tes émulateurs et ceux que tu ajoutes ici. Tes jeux et tes sauvegardes ne sont jamais modifiés."/>
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="RetroArch" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="RetroArchStatusText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="9" Grid.Column="2" x:Name="RetroArchButton" Content="Configurer…" Tag="RetroArch" Click="EmulatorButton_Click"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Dolphin" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" x:Name="DolphinStatusText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="10" Grid.Column="2" x:Name="DolphinButton" Content="Configurer…" Tag="Dolphin" Click="EmulatorButton_Click"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Ryujinx" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="RyujinxStatusText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="11" Grid.Column="2" x:Name="RyujinxButton" Content="Configurer…" Tag="Ryujinx" Click="EmulatorButton_Click"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Azahar" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" x:Name="AzaharStatusText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="12" Grid.Column="2" x:Name="AzaharButton" Content="Configurer…" Tag="Azahar" Click="EmulatorButton_Click"/>

                        <!-- Facultatif : les succès des jeux émulés (GB, GBC, GBA, DS, GameCube, Wii) -->
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="RetroAchievements" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" x:Name="RetroAchievementsStatusText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Grid.Row="13" Grid.Column="2" x:Name="RetroAchievementsButton" Click="RetroAchievementsButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== Onglet Réglages ===================== -->
        <TabItem Header="Réglages">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel.Resources>
                        <Style x:Key="SettingsSection" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0,20,0,8"/>
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Réglages" FontSize="22" FontWeight="Bold"/>

                    <TextBlock Text="Apparence" Style="{StaticResource SettingsSection}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Clair" Margin="0,0,20,0"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Sombre"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>

                    <TextBlock Text="Clés API" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tes clés restent sur ce PC, chiffrées : seul ton compte Windows peut les relire."/>
                    <TextBlock x:Name="ApiKeysSummaryText" FontFamily="Consolas" Margin="0,0,0,8"/>
                    <Button Content="Modifier les clés…" Height="32" Padding="12,0" HorizontalAlignment="Left"
                            Click="EditApiKeysButton_Click"/>

                    <!-- Tag = le nom de la plateforme (énumération Platform), enregistré dans settings.json. -->
                    <TextBlock Text="Lanceurs" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Décoche un lanceur que tu n'utilises pas : Wyrmhold ne le lit plus et masque ses jeux. Rien n'est supprimé : recoche-le pour tout retrouver (temps de jeu, succès, collections)."/>
                    <WrapPanel x:Name="LauncherChecks">
                        <CheckBox Content="Steam" Tag="Steam" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Epic Games" Tag="Epic" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Ubisoft Connect" Tag="Ubisoft" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="GOG" Tag="Gog" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="EA app" Tag="Ea" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Battle.net" Tag="BattleNet" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="RetroArch" Tag="RetroArch" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Dolphin" Tag="Dolphin" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Ryujinx" Tag="Ryujinx" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                        <CheckBox Content="Azahar" Tag="Azahar" Margin="0,0,20,6" Checked="LauncherCheck_Changed" Unchecked="LauncherCheck_Changed"/>
                    </WrapPanel>

                    <TextBlock Text="Bibliothèque" Style="{StaticResource SettingsSection}"/>
                    <CheckBox x:Name="MergeDuplicatesCheck"
                              Content="Regrouper un même jeu possédé sur plusieurs plateformes"
                              Checked="MergeDuplicatesCheck_Changed" Unchecked="MergeDuplicatesCheck_Changed"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Une seule tuile par jeu ; la liste « Plateforme » de la fiche choisit la copie à lancer. Les jeux sont reconnus par leur nom."/>

                    <CheckBox x:Name="AutoRefreshCheck" Content="Actualisation automatique" Margin="0,12,0,0"
                              Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed"/>
                    <!-- Tag = minutes, enregistré dans settings.json (AppSettings.AutoRefreshMinutes) -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Synchro complète avec les comptes en ligne :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="AutoRefreshIntervalBox" Width="170" SelectionChanged="AutoRefreshIntervalBox_SelectionChanged">
                            <ComboBoxItem Content="toutes les 15 min" Tag="15"/>
                            <ComboBoxItem Content="toutes les 30 min" Tag="30"/>
                            <ComboBoxItem Content="toutes les heures" Tag="60"/>
                            <ComboBoxItem Content="toutes les 2 heures" Tag="120"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Un jeu installé ou désinstallé par Steam ou Epic apparaît tout seul, quelques secondes après (sans internet). La synchro complète (comptes, jaquettes, succès) se fait aussi quand tu reviens sur Wyrmhold après plus de 10 minutes. Jamais pendant une partie, ni quand Wyrmhold est caché ou réduit : elle attend. Décoché = seulement le bouton « Actualiser »."/>

                    <TextBlock Text="Succès" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Décoche une plateforme pour que Wyrmhold arrête de lire ses succès. Les chiffres déjà connus restent affichés."/>
                    <CheckBox x:Name="SteamAchievementsCheck" Content="Steam" Tag="Steam" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="GogAchievementsCheck" Content="GOG" Tag="Gog" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="EpicAchievementsCheck" Content="Epic Games" Tag="Epic" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="RetroArchAchievementsCheck" Content="RetroArch (RetroAchievements)" Tag="RetroArch" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="DolphinAchievementsCheck" Content="Dolphin (RetroAchievements)" Tag="Dolphin" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="RyujinxAchievementsCheck" Content="Ryujinx (succès maison, lus dans la sauvegarde)" Tag="Ryujinx" Margin="0,0,0,6"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>
                    <CheckBox x:Name="AzaharAchievementsCheck" Content="Azahar (succès maison, lus dans la sauvegarde)" Tag="Azahar"
                              Checked="AchievementSourceCheck_Changed" Unchecked="AchievementSourceCheck_Changed"/>

                    <!-- L'état de la case vient du registre de Windows (voir WindowsStartup et LoadStartWithWindows). -->
                    <TextBlock Text="Démarrage" Style="{StaticResource SettingsSection}"/>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Lancer Wyrmhold au démarrage de Windows"
                              Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Wyrmhold s'ouvre caché près de l'horloge, sans fenêtre : l'overlay et les notifications de succès sont prêts dès le début. Double-clic sur son icône pour l'ouvrir. Il cherche aussi sa mise à jour, sans rien afficher. Tu peux aussi le retirer dans le Gestionnaire des tâches (Applications de démarrage)."/>
                    <TextBlock x:Name="StartWithWindowsStatusText" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <!-- Tag = la valeur enregistrée dans settings.json (voir CloseActions) -->
                    <TextBlock Text="Fermeture" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Ce que fait la croix de la fenêtre. En arrière-plan, Wyrmhold reste près de l'horloge (clic droit sur son icône → Quitter)."/>
                    <RadioButton x:Name="CloseAskRadio" GroupName="CloseAction" Content="Demander à chaque fois"
                                 Tag="ask" Margin="0,0,0,6" Checked="CloseActionRadio_Checked"/>
                    <RadioButton x:Name="CloseBackgroundRadio" GroupName="CloseAction" Content="Garder en arrière-plan"
                                 Tag="background" Margin="0,0,0,6" Checked="CloseActionRadio_Checked"/>
                    <RadioButton x:Name="CloseQuitRadio" GroupName="CloseAction" Content="Quitter complètement"
                                 Tag="quit" Checked="CloseActionRadio_Checked"/>

                    <TextBlock Text="Overlay en jeu" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Un écran tout en un par-dessus le jeu en cours, comme celui de Steam : succès, session, aide et guides, bloc-notes, processeur et mémoire. Tant qu'il est ouvert, il prend le clavier et la souris ; Échap rend la main au jeu. Il ne s'affiche qu'au-dessus des jeux en mode fenêtré ou fenêtré sans bordure."/>
                    <CheckBox x:Name="OverlayEnabledCheck"
                              Content="Activer l'overlay (Wyrmhold repère le jeu en cours toutes les 5 secondes)"
                              Margin="0,0,0,8"
                              Checked="OverlayEnabledCheck_Changed" Unchecked="OverlayEnabledCheck_Changed"/>
                    <!-- Lecture seule : on n'écrit pas dedans, on y appuie sur la combinaison voulue. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Raccourci pour ouvrir ou fermer l'overlay :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="OverlayHotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                    </StackPanel>
                    <TextBlock x:Name="OverlayHotkeyStatusText" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,8"
                               Text="Succès en direct : pendant que tu joues, Wyrmhold relit les succès du jeu toutes les 60 secondes (sources cochées dans « Succès ») et affiche une notification en haut à droite à chaque déblocage, même overlay caché."/>
                    <CheckBox x:Name="MuteSteamAchievementsCheck"
                              Content="Ne pas notifier les succès Steam (Steam affiche déjà les siens)"
                              Margin="0,0,0,8"
                              Checked="MuteSteamAchievementsCheck_Changed" Unchecked="MuteSteamAchievementsCheck_Changed"/>
                    <CheckBox x:Name="AchievementSoundCheck"
                              Content="Jouer un son avec chaque notification (un plus festif pour le 100 %)"
                              Margin="0,0,0,8"
                              Checked="AchievementSoundCheck_Changed" Unchecked="AchievementSoundCheck_Changed"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tester la notification" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Click="TestToastButton_Click"/>
                        <Button Content="Tester le 100 %" Height="32" Padding="12,0"
                                Click="TestCompletedToastButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="Signaler un problème" Style="{StaticResource SettingsSection}"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Prépare un rapport (version, Windows, dernières lignes du journal) sans tes données personnelles. Tu le relis avant de l'envoyer : rien ne part sans ton accord."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🐞 Signaler un bug" Height="32" Padding="12,0" Margin="0,0,12,0"
                                Click="ReportBugButton_Click"/>
                        <Button Content="📄 Ouvrir le journal" Height="32" Padding="12,0" Margin="0,0,12,0"
                                ToolTip="Le fichier où Wyrmhold note ce qui s'est mal passé"
                                Click="OpenLogButton_Click"/>
                        <!-- Visible seulement en version Debug (voir Window_Loaded) : sert à tester le rapport de plantage. -->
                        <Button x:Name="TestCrashButton" Content="Tester un plantage" Height="32" Padding="12,0" Margin="0,0,12,0"
                                Visibility="Collapsed" Click="TestCrashButton_Click"/>
                        <Image Source="/Assets/logo-256.png" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Content="À propos" Height="32" Padding="12,0" Margin="12,0,0,0" Click="AboutButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
