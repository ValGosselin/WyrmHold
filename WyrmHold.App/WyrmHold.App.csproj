<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- « 10.0.17763.0 » = Windows 10 version 1809 au minimum. Sans ce numéro, la bibliothèque Windows
         Microsoft.Windows.SDK.NET n'est pas livrée avec Wyrmhold, et le navigateur de l'overlay
         (WebView2CompositionControl, qui en a besoin) faisait planter l'appli (9 octobre 2026). -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	 <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF0001 : Application.ThemeMode (thème Fluent clair/sombre) est encore marqué « expérimental »
         dans .NET 10. On l'utilise quand même, en sachant que Microsoft peut encore le modifier. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- Le logo (fabriqué par tools\make-logo.ps1) : icône du programme, donc aussi des fenêtres,
         de la barre des tâches et de l'icône près de l'horloge. -->
    <ApplicationIcon>Assets\wyrmhold.ico</ApplicationIcon>

    <!-- Velopack (installateur et mises à jour) doit passer en tout premier au démarrage :
         on écrit nous-mêmes la méthode Main (dans App.xaml.cs) au lieu de laisser WPF la générer. -->
    <StartupObject>WyrmHold.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml compilé comme une page normale : sinon WPF génère sa propre méthode Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />

    <Resource Include="Assets\logo-256.png" />

    <!-- Livrés à côté du programme (la GPL demande que la licence accompagne le logiciel) ;
         la fenêtre « À propos » les ouvre. -->
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE.md" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WyrmHold.Core\WyrmHold.Core.csproj" />
  </ItemGroup>
	<ItemGroup>
		<Using Remove="System.Drawing" />
		<Using Remove="System.Windows.Forms" />
	</ItemGroup>
</Project>
