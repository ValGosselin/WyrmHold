<Window x:Class="WyrmHold.App.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="170" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Height="28" Padding="6,0" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Annuler" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
