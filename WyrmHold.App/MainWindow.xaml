<Window x:Class="WyrmHold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WyrmHold.App"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="Wyrmhold" Height="750" Width="1200"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <TabControl Margin="10">

        <!-- ===================== Onglet Bibliothèque ===================== -->
        <TabItem Header="Bibliothèque">
            <DockPanel Margin="10">

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button x:Name="RefreshButton" Content="Actualiser" Width="100" Margin="0,0,10,0"
                            Click="RefreshButton_Click"/>
                    <Button Content="Jouer" Width="100"
                            Click="PlayButton_Click"/>
                </StackPanel>

                <!-- Fiche détaillée du jeu sélectionné -->
                <Border DockPanel.Dock="Right" Width="320" Margin="10,0,0,0" Padding="12"
                        BorderBrush="#DDDDDD" BorderThickness="1"
                        DataContext="{Binding SelectedItem, ElementName=GamesList}">
                    <Grid>
                        <TextBlock Text="Sélectionne un jeu pour voir sa fiche."
                                   Foreground="Gray" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel>
                                <Image local:CoverLoader.Path="{Binding CoverPath}"
                                       Width="200" Height="300" Stretch="UniformToFill"
                                       HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="Gray"/>

                                <Border Background="#FFB300" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEarlyAccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Accès anticipé" FontWeight="SemiBold"/>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Statut" Foreground="Gray" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallStatusText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Temps de jeu" Foreground="Gray" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlaytimeText}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dernière partie" Foreground="Gray" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPlayedText}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sortie" Foreground="Gray" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseDateText}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Développeur" Foreground="Gray" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Developers}" TextWrapping="Wrap"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TagList}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#EEEEEE" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Grille de jaquettes -->
                <ListBox x:Name="GamesList"
                         MouseDoubleClick="GamesList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.CacheLength="1,1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="150" Margin="6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Height="225" Background="#2A2A2A">
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="8"/>
                                    <Image local:CoverLoader.Path="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- ===================== Onglet Comptes ===================== -->
        <TabItem Header="Comptes">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Comptes" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,20"
                               Text="Connecte tes comptes pour ajouter à ta bibliothèque les jeux que tu possèdes, même non installés. Une fois connecté, Wyrmhold se synchronise tout seul à chaque démarrage et à chaque actualisation."/>

                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="140"/>
                                <Setter Property="Height" Value="28"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SteamStatusText" Foreground="Gray"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Famille Steam" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SteamFamilyStatusText" Foreground="Gray"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="SteamFamilyButton" Click="SteamFamilyButton_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GOG" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GogStatusText" Foreground="Gray"/>
                        <Button Grid.Row="2" Grid.Column="2" x:Name="GogAccountButton" Click="GogAccountButton_Click"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Epic Games" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EpicStatusText" Foreground="Gray"/>
                        <Button Grid.Row="3" Grid.Column="2" x:Name="EpicAccountButton" Click="EpicAccountButton_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ubisoft Connect" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UbisoftStatusText" Foreground="Gray"/>
                        <Button Grid.Row="4" Grid.Column="2" x:Name="UbisoftAccountButton" Click="UbisoftAccountButton_Click"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="EA app" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Bientôt disponible" Foreground="Gray"/>
                        <Button Grid.Row="5" Grid.Column="2" Content="Se connecter" IsEnabled="False"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Battle.net" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Bientôt disponible" Foreground="Gray"/>
                        <Button Grid.Row="6" Grid.Column="2" Content="Se connecter" IsEnabled="False"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>