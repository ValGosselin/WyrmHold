<!-- Ce qu'apporte une nouvelle version : ouverte une fois après une mise à jour, et depuis « À propos ». -->
<Window x:Class="WyrmHold.App.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quoi de neuf dans Wyrmhold"
        Height="520" Width="560" MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/logo-256.png" Width="48" Height="48" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Quoi de neuf" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel x:Name="NotesList"/>
        </ScrollViewer>

        <!-- Click et pas IsCancel : IsCancel ne ferme qu'une fenêtre ouverte avec ShowDialog. -->
        <Button Grid.Row="2" Content="Fermer" Width="90" Height="32" HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
